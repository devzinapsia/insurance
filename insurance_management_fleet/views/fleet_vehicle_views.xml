<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="fleet_vehicle_view_form_insurance" model="ir.ui.view">
        <field name="name">fleet.vehicle.form.insurance</field>
        <field name="model">fleet.vehicle</field>
        <field name="inherit_id" ref="fleet.fleet_vehicle_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_insurance_policies" type="object" class="oe_stat_button" icon="fa-shield"
                        groups="insurance_management.group_insurance_user">
                    <div class="o_stat_info">
                        <span class="o_stat_value"><field name="insurance_policy_count"/></span>
                        <span class="o_stat_text text-success" invisible="not insured_today">Insured</span>
                        <span class="o_stat_text text-danger" invisible="insured_today">Not insured</span>
                    </div>
                </button>
                <button name="action_view_insurance_claims" type="object" class="oe_stat_button" icon="fa-exclamation-triangle"
                        groups="insurance_management.group_insurance_user">
                    <field name="insurance_claim_count" widget="statinfo" string="Claims"/>
                </button>
                <field name="insured_today" invisible="1" groups="insurance_management.group_insurance_user"/>
            </xpath>
        </field>
    </record>

    <record id="fleet_vehicle_view_tree_insurance" model="ir.ui.view">
        <field name="name">fleet.vehicle.list.insurance</field>
        <field name="model">fleet.vehicle</field>
        <field name="inherit_id" ref="fleet.fleet_vehicle_view_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='acquisition_date']" position="after">
                <field name="insurance_policy_id" optional="hide" groups="insurance_management.group_insurance_user"/>
                <field name="insured_today" optional="hide" groups="insurance_management.group_insurance_user"/>
            </xpath>
        </field>
    </record>

    <record id="fleet_vehicle_view_search_insurance" model="ir.ui.view">
        <field name="name">fleet.vehicle.search.insurance</field>
        <field name="model">fleet.vehicle</field>
        <field name="inherit_id" ref="fleet.fleet_vehicle_view_search"/>
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='alert_true']" position="after">
                <filter name="insured_today" string="Insured today" domain="[('insured_today', '=', True)]" groups="insurance_management.group_insurance_user"/>
                <filter name="not_insured" string="Without insurance in force" domain="[('insured_today', '=', False)]" groups="insurance_management.group_insurance_user"/>
            </xpath>
        </field>
    </record>
</odoo>
