<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="insurance_policy_document_upload_view_form" model="ir.ui.view">
        <field name="name">insurance.policy.document.upload.form</field>
        <field name="model">insurance.policy.document.upload</field>
        <field name="arch" type="xml">
            <form string="Upload document">
                <group>
                    <field name="policy_id" invisible="not policy_id"/>
                    <field name="claim_id" invisible="not claim_id"/>
                    <field name="document_type_id" options="{'no_create': True}"/>
                    <field name="file" filename="filename"/>
                    <field name="filename" invisible="1"/>
                    <field name="description" placeholder="e.g. Policy 2026 signed"/>
                </group>
                <footer>
                    <button name="action_upload" type="object" string="Upload" class="btn-primary" data-hotkey="q"/>
                    <button string="Discard" special="cancel" class="btn-secondary" data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
