              name="Branches"
              parent="menu_insurance_configuration"
              action="insurance_branch_action"
              sequence="20"/>

    <menuitem id="menu_insurance_settings"
              name="Settings"
              parent="menu_insurance_configuration"
              action="insurance_settings_action"
              sequence="1"/>

    <menuitem id="menu_insurance_import"
              name="Import running policies"
              parent="menu_insurance_configuration"
              action="insurance_import_action"
              sequence="90"/>

    <menuitem id="menu_insurance_document_type"
              name="Document types"
              parent="menu_insurance_configuration"
              action="insurance_document_type_action"
              sequence="30"/>

    <menuitem id="menu_insurance_endorsement_type"
              name="Endorsement types"
              parent="menu_insurance_configuration"
              action="insurance_endorsement_type_action"
              sequence="25"/>

    <menuitem id="menu_insurance_payment_mode"
              name="Payment modes"
              parent="menu_insurance_configuration"
              action="insurance_payment_mode_action"
              sequence="27"/>
