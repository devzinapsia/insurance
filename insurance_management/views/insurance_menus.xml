              name="Insurance"
              web_icon="insurance_management,static/description/icon.png"
              action="insurance_policy_action"
              groups="group_insurance_user"
              sequence="60"/>

    <menuitem id="menu_insurance_dashboard"
              name="Dashboard"
              parent="menu_insurance_root"
              action="action_server_insurance_dashboard"
              sequence="5"/>

    <menuitem id="menu_insurance_policies"
              name="Policies"
              parent="menu_insurance_root"
              sequence="10"/>

    <menuitem id="menu_insurance_policy"
              name="Policies"
              parent="menu_insurance_policies"
              action="insurance_policy_action"
              sequence="10"/>

    <menuitem id="menu_insurance_insured_item"
              name="Insurable items"
              parent="menu_insurance_policies"
              action="insurance_insured_item_action"
              sequence="20"/>

    <menuitem id="menu_insurance_endorsement"
              name="Endorsements"
              parent="menu_insurance_policies"
              action="insurance_endorsement_action"
              sequence="15"/>

    <menuitem id="menu_insurance_installment"
              name="Installments"
              parent="menu_insurance_policies"
              action="insurance_installment_action"
              sequence="17"/>

    <menuitem id="menu_insurance_claim"
              name="Claims"
              parent="menu_insurance_policies"
              action="insurance_claim_action"
              sequence="18"/>

    <menuitem id="menu_insurance_surety"
              name="Surety bonds"
              parent="menu_insurance_policies"
              action="insurance_policy_surety_action"
              sequence="19"/>

    <menuitem id="menu_insurance_reporting"
              name="Reporting"
              parent="menu_insurance_root"
              sequence="50"/>

    <menuitem id="menu_insurance_report_expiration"
              name="Upcoming expirations"
              parent="menu_insurance_reporting"
              action="insurance_policy_expiration_action"
              sequence="10"/>

    <record id="action_server_print_policies_in_force" model="ir.actions.server">
        <field name="name">Policies in force (PDF)</field>
        <field name="model_id" ref="model_insurance_policy"/>
        <field name="state">code</field>
        <field name="code">action = model.action_print_policies_in_force()</field>
        <field name="group_ids" eval="[Command.link(ref('group_insurance_user'))]"/>
    </record>

    <menuitem id="menu_insurance_report_in_force_pdf"
              name="Policies in force (PDF)"
              parent="menu_insurance_reporting"
              action="action_server_print_policies_in_force"
              sequence="20"/>

    <menuitem id="menu_insurance_report_installments"
              name="Installments per month"
              parent="menu_insurance_reporting"
              action="insurance_installment_report_action"
              sequence="30"/>

    <menuitem id="menu_insurance_report_cost"
              name="Cost by branch and insurer"
              parent="menu_insurance_reporting"
              action="insurance_cost_report_action"
              groups="insurance_management.group_insurance_see_amounts"
              sequence="35"/>

    <menuitem id="menu_insurance_report_accrual"
              name="Accrual plan"
              parent="menu_insurance_reporting"
              action="insurance_accrual_line_action"
              groups="account.group_account_invoice,account.group_account_readonly"
              sequence="40"/>

    <menuitem id="menu_insurance_report_claims"
              name="Claims and recoveries"
              parent="menu_insurance_reporting"
              action="insurance_claim_report_action"
              groups="insurance_management.group_insurance_see_amounts"
              sequence="45"/>

    <menuitem id="menu_insurance_report_sureties"
              name="Surety bonds by beneficiary"
              parent="menu_insurance_reporting"
              action="insurance_policy_surety_report_action"
