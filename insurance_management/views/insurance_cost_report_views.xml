<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="insurance_cost_report_view_pivot" model="ir.ui.view">
        <field name="name">insurance.cost.report.pivot</field>
        <field name="model">insurance.cost.report</field>
        <field name="arch" type="xml">
            <pivot string="Cost by branch and insurer" sample="1">
                <field name="branch_id" type="row"/>
                <field name="insurer_id" type="col"/>
                <field name="amount" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="insurance_cost_report_view_graph" model="ir.ui.view">
        <field name="name">insurance.cost.report.graph</field>
        <field name="model">insurance.cost.report</field>
        <field name="arch" type="xml">
            <graph string="Cost by branch and insurer" type="bar" stacked="1" sample="1">
                <field name="branch_id"/>
                <field name="insurer_id"/>
                <field name="amount" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="insurance_cost_report_view_list" model="ir.ui.view">
        <field name="name">insurance.cost.report.list</field>
        <field name="model">insurance.cost.report</field>
        <field name="arch" type="xml">
            <list string="Cost by branch and insurer" create="0">
                <field name="date"/>
                <field name="move_id" groups="account.group_account_invoice,account.group_account_readonly"/>
                <field name="policy_id"/>
                <field name="branch_id"/>
                <field name="insurer_id"/>
                <field name="company_currency_id" column_invisible="True"/>
                <field name="currency_id" column_invisible="True"/>
                <field name="amount" sum="Total"/>
                <field name="amount_currency" optional="show"/>
            </list>
        </field>
    </record>

    <record id="insurance_cost_report_view_search" model="ir.ui.view">
        <field name="name">insurance.cost.report.search</field>
        <field name="model">insurance.cost.report</field>
        <field name="arch" type="xml">
            <search string="Cost by branch and insurer">
                <field name="policy_id"/>
                <field name="branch_id"/>
                <field name="insurer_id"/>
                <filter name="filter_date" string="Date" date="date" default_period="year"/>
                <group name="group_by">
                    <filter name="group_by_branch" string="Branch" context="{'group_by': 'branch_id'}"/>
                    <filter name="group_by_insurer" string="Insurer" context="{'group_by': 'insurer_id'}"/>
                    <filter name="group_by_policy" string="Policy" context="{'group_by': 'policy_id'}"/>
                    <filter name="group_by_currency" string="Currency" context="{'group_by': 'currency_id'}"/>
                    <filter name="group_by_month" string="Month" context="{'group_by': 'date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="insurance_cost_report_action" model="ir.actions.act_window">
        <field name="name">Cost by branch and insurer</field>
        <field name="res_model">insurance.cost.report</field>
        <field name="view_mode">pivot,graph,list</field>
        <field name="search_view_id" ref="insurance_cost_report_view_search"/>
        <field name="context">{'search_default_filter_date': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No insurance bills posted yet</p>
            <p>Premiums billed by the insurers (net of taxes, credit notes deducted), in company currency and in the currency of each policy.</p>
        </field>
    </record>
</odoo>
