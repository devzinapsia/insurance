<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Without these views Odoo builds a default form where the color is a
         plain integer; the color_picker widget shows the usual palette. -->
    <record id="insurance_policy_tag_view_form" model="ir.ui.view">
        <field name="name">insurance.policy.tag.form</field>
        <field name="model">insurance.policy.tag</field>
        <field name="arch" type="xml">
            <form string="Tags">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="color" widget="color_picker"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="insurance_policy_tag_view_list" model="ir.ui.view">
        <field name="name">insurance.policy.tag.list</field>
        <field name="model">insurance.policy.tag</field>
        <field name="arch" type="xml">
            <list string="Tags" editable="bottom">
                <field name="name"/>
                <field name="color" widget="color_picker"/>
            </list>
        </field>
    </record>
</odoo>
