#. module: insurance_management
#: model:mail.template,body_html:insurance_management.mail_template_surety_release_request
msgid ""
"<div style=\"margin:0; padding:0; background-color:#f3f4f6;\">\n"
"<t t-set=\"recipient\" t-value=\"object._get_surety_release_recipient()\"/>\n"
"<t t-set=\"amount\" t-value=\"object._get_mail_surety_amount()\"/>\n"
"<table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"background-color:#f3f4f6;\">\n"
"<tr><td align=\"center\" style=\"padding:24px 12px;\">\n"
"<table role=\"presentation\" width=\"600\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"width:100%; max-width:600px; background-color:#ffffff; border:1px solid #d1d5db; border-radius:6px; font-family:Arial, Helvetica, sans-serif; color:#1f2937;\">\n"
"    <tr><td style=\"padding:20px 24px; border-bottom:3px solid #1f4e79;\">\n"
"        <img t-att-src=\"'%s/logo.png?company=%s' % (object.get_base_url(), object.company_id.id)\" t-att-alt=\"object.company_id.name\" height=\"40\" style=\"height:40px; max-width:200px; border:0; display:block;\"/>\n"
"    </td></tr>\n"
"    <tr><td style=\"padding:24px 24px 8px 24px; font-size:15px; line-height:22px;\">\n"
"        <p style=\"margin:0 0 16px 0;\">Hello <t t-out=\"recipient.name or ''\">Beneficiary</t>,</p>\n"
"        <p style=\"margin:0 0 16px 0; font-size:17px; line-height:24px; font-weight:bold; color:#1f4e79;\">We ask you for the release of the following surety bond.</p>\n"
"        <p style=\"margin:0 0 16px 0;\">The obligation it guarantees is fulfilled or about to end. Please send us the signed release certificate, so we can return the surety bond to the insurer.</p>\n"
"    </td></tr>\n"
"    <tr><td style=\"padding:0 24px 8px 24px;\">\n"
"        <table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"font-size:14px; line-height:20px; border-collapse:collapse;\">\n"
"            <tr t-if=\"object.policy_number\">\n"
"                <td style=\"padding:8px; width:38%; color:#4b5563; border-bottom:1px solid #e5e7eb;\">Surety bond number</td>\n"
"                <td style=\"padding:8px; font-weight:bold; border-bottom:1px solid #e5e7eb;\" t-out=\"object.policy_number\">POL-001</td>\n"
"            </tr>\n"
"            <tr t-if=\"object.insurer_id\">\n"
"                <td style=\"padding:8px; color:#4b5563; border-bottom:1px solid #e5e7eb;\">Insurer</td>\n"
"                <td style=\"padding:8px; border-bottom:1px solid #e5e7eb;\" t-out=\"object.insurer_id.name\">Insurer</td>\n"
"            </tr>\n"
"            <tr t-if=\"object.surety_type\">\n"
"                <td style=\"padding:8px; color:#4b5563; border-bottom:1px solid #e5e7eb;\">Surety type</td>\n"
"                <td style=\"padding:8px; border-bottom:1px solid #e5e7eb;\" t-out=\"object._get_surety_type_label()\">Performance bond</td>\n"
"            </tr>\n"
"            <tr t-if=\"object.surety_obligation\">\n"
"                <td style=\"padding:8px; color:#4b5563; border-bottom:1px solid #e5e7eb;\">Guaranteed obligation</td>\n"
"                <td style=\"padding:8px; border-bottom:1px solid #e5e7eb;\" t-out=\"object.surety_obligation\">Tender 12/2026</td>\n"
"            </tr>\n"
"            <tr t-if=\"amount\">\n"
"                <td style=\"padding:8px; color:#4b5563; border-bottom:1px solid #e5e7eb;\">Guaranteed amount</td>\n"
"                <td style=\"padding:8px; border-bottom:1px solid #e5e7eb;\" t-out=\"amount\">$ 1,000,000.00</td>\n"
"            </tr>\n"
"            <tr t-if=\"object.surety_obligation_end\">\n"
"                <td style=\"padding:8px; color:#4b5563; border-bottom:1px solid #e5e7eb;\">Obligation end</td>\n"
"                <td style=\"padding:8px; border-bottom:1px solid #e5e7eb;\" t-out=\"format_date(object.surety_obligation_end)\">30/06/2027</td>\n"
"            </tr>\n"
"        </table>\n"
"    </td></tr>\n"
"    <tr><td style=\"padding:20px 24px 24px 24px; font-size:15px; line-height:22px;\">\n"
"        <p style=\"margin:0 0 16px 0;\">Thank you in advance.</p>\n"
"        <p style=\"margin:0;\">Kind regards,<br/>\n"
"            <strong t-out=\"object.company_id.name or ''\">My Company</strong>\n"
"            <t t-if=\"object.company_id.email\"><br/><t t-out=\"object.company_id.email\">info@example.com</t></t>\n"
"            <t t-if=\"object.company_id.phone\"><br/><t t-out=\"object.company_id.phone\">+54 11 0000-0000</t></t>\n"
"        </p>\n"
"    </td></tr>\n"
"</table>\n"
"</td></tr>\n"
"</table>\n"
"</div>\n"
"            "
msgstr "<div style=\"margin:0; padding:0; background-color:#f3f4f6;\">\n<t t-set=\"recipient\" t-value=\"object._get_surety_release_recipient()\"/>\n<t t-set=\"amount\" t-value=\"object._get_mail_surety_amount()\"/>\n<table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"background-color:#f3f4f6;\">\n<tr><td align=\"center\" style=\"padding:24px 12px;\">\n<table role=\"presentation\" width=\"600\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"width:100%; max-width:600px; background-color:#ffffff; border:1px solid #d1d5db; border-radius:6px; font-family:Arial, Helvetica, sans-serif; color:#1f2937;\">\n    <tr><td style=\"padding:20px 24px; border-bottom:3px solid #1f4e79;\">\n        <img t-att-src=\"'%s/logo.png?company=%s' % (object.get_base_url(), object.company_id.id)\" t-att-alt=\"object.company_id.name\" height=\"40\" style=\"height:40px; max-width:200px; border:0; display:block;\"/>\n    </td></tr>\n    <tr><td style=\"padding:24px 24px 8px 24px; font-size:15px; line-height:22px;\">\n        <p style=\"margin:0 0 16px 0;\">Hola <t t-out=\"recipient.name or ''\">Beneficiario</t>,</p>\n        <p style=\"margin:0 0 16px 0; font-size:17px; line-height:24px; font-weight:bold; color:#1f4e79;\">Le pedimos la liberación de la siguiente caución.</p>\n        <p style=\"margin:0 0 16px 0;\">La obligación que garantiza está cumplida o por terminar. Por favor envíenos la constancia de liberación firmada, así podemos devolver la caución a la aseguradora.</p>\n    </td></tr>\n    <tr><td style=\"padding:0 24px 8px 24px;\">\n        <table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"font-size:14px; line-height:20px; border-collapse:collapse;\">\n            <tr t-if=\"object.policy_number\">\n                <td style=\"padding:8px; width:38%; color:#4b5563; border-bottom:1px solid #e5e7eb;\">Número de caución</td>\n                <td style=\"padding:8px; font-weight:bold; border-bottom:1px solid #e5e7eb;\" t-out=\"object.policy_number\">POL-001</td>\n            </tr>\n            <tr t-if=\"object.insurer_id\">\n                <td style=\"padding:8px; color:#4b5563; border-bottom:1px solid #e5e7eb;\">Aseguradora</td>\n                <td style=\"padding:8px; border-bottom:1px solid #e5e7eb;\" t-out=\"object.insurer_id.name\">Aseguradora</td>\n            </tr>\n            <tr t-if=\"object.surety_type\">\n                <td style=\"padding:8px; color:#4b5563; border-bottom:1px solid #e5e7eb;\">Tipo de caución</td>\n                <td style=\"padding:8px; border-bottom:1px solid #e5e7eb;\" t-out=\"object._get_surety_type_label()\">Cumplimiento de contrato</td>\n            </tr>\n            <tr t-if=\"object.surety_obligation\">\n                <td style=\"padding:8px; color:#4b5563; border-bottom:1px solid #e5e7eb;\">Obligación garantizada</td>\n                <td style=\"padding:8px; border-bottom:1px solid #e5e7eb;\" t-out=\"object.surety_obligation\">Licitación 12/2026</td>\n            </tr>\n            <tr t-if=\"amount\">\n                <td style=\"padding:8px; color:#4b5563; border-bottom:1px solid #e5e7eb;\">Monto garantizado</td>\n                <td style=\"padding:8px; border-bottom:1px solid #e5e7eb;\" t-out=\"amount\">$ 1,000,000.00</td>\n            </tr>\n            <tr t-if=\"object.surety_obligation_end\">\n                <td style=\"padding:8px; color:#4b5563; border-bottom:1px solid #e5e7eb;\">Fin de la obligación</td>\n                <td style=\"padding:8px; border-bottom:1px solid #e5e7eb;\" t-out=\"format_date(object.surety_obligation_end)\">30/06/2027</td>\n            </tr>\n        </table>\n    </td></tr>\n    <tr><td style=\"padding:20px 24px 24px 24px; font-size:15px; line-height:22px;\">\n        <p style=\"margin:0 0 16px 0;\">Desde ya, muchas gracias.</p>\n        <p style=\"margin:0;\">Saludos cordiales,<br/>\n            <strong t-out=\"object.company_id.name or ''\">My Company</strong>\n            <t t-if=\"object.company_id.email\"><br/><t t-out=\"object.company_id.email\">info@example.com</t></t>\n            <t t-if=\"object.company_id.phone\"><br/><t t-out=\"object.company_id.phone\">+54 11 0000-0000</t></t>\n        </p>\n    </td></tr>\n</table>\n</td></tr>\n</table>\n</div>\n            "

