#. module: insurance_management
#: model:mail.template,body_html:insurance_management.mail_template_claim_stale
msgid ""
"<div style=\"margin:0; padding:0; background-color:#f3f4f6;\">\n"
"<t t-set=\"claimed\" t-value=\"object._get_mail_amount('amount_claimed')\"/>\n"
"<t t-set=\"pending\" t-value=\"object._get_mail_amount('amount_pending')\"/>\n"
"<table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"background-color:#f3f4f6;\">\n"
"<tr><td align=\"center\" style=\"padding:24px 12px;\">\n"
"<table role=\"presentation\" width=\"600\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"width:100%; max-width:600px; background-color:#ffffff; border:1px solid #d1d5db; border-radius:6px; font-family:Arial, Helvetica, sans-serif; color:#1f2937;\">\n"
"    <tr><td style=\"padding:20px 24px; border-bottom:3px solid #b54708;\">\n"
"        <img t-att-src=\"'%s/logo.png?company=%s' % (object.get_base_url(), object.company_id.id)\" t-att-alt=\"object.company_id.name\" height=\"40\" style=\"height:40px; max-width:200px; border:0; display:block;\"/>\n"
"    </td></tr>\n"
"    <tr><td style=\"padding:24px 24px 8px 24px; font-size:15px; line-height:22px;\">\n"
"        <p style=\"margin:0 0 16px 0;\">Hello <t t-out=\"ctx.get('insurance_recipient_name') or ''\">Marc Demo</t>,</p>\n"
"        <p style=\"margin:0 0 16px 0; font-size:17px; line-height:24px; font-weight:bold; color:#b54708;\" t-out=\"object._get_stale_subject()\">Claim SIN/2026/0001 (policy POL-001) has had no movement for 30 days</p>\n"
"        <p style=\"margin:0 0 16px 0;\">The status of this claim has not changed for a while. Follow it up with the insurer or the producer.</p>\n"
"    </td></tr>\n"
"    <tr><td style=\"padding:0 24px 8px 24px;\">\n"
"        <table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"font-size:14px; line-height:20px; border-collapse:collapse;\">\n"
"            <tr>\n"
"                <td style=\"padding:8px; width:38%; color:#4b5563; border-bottom:1px solid #e5e7eb;\">Claim</td>\n"
"                <td style=\"padding:8px; font-weight:bold; border-bottom:1px solid #e5e7eb;\" t-out=\"object.display_name\">SIN/2026/0001</td>\n"
"            </tr>\n"
"            <tr>\n"
"                <td style=\"padding:8px; color:#4b5563; border-bottom:1px solid #e5e7eb;\">Policy</td>\n"
"                <td style=\"padding:8px; border-bottom:1px solid #e5e7eb;\" t-out=\"object.policy_id.display_name\">SEG/2026/0001 - POL-001</td>\n"
"            </tr>\n"
"            <tr t-if=\"object.insurer_id\">\n"
"                <td style=\"padding:8px; color:#4b5563; border-bottom:1px solid #e5e7eb;\">Insurer</td>\n"
"                <td style=\"padding:8px; border-bottom:1px solid #e5e7eb;\" t-out=\"object.insurer_id.name\">Insurer</td>\n"
"            </tr>\n"
"            <tr>\n"
"                <td style=\"padding:8px; color:#4b5563; border-bottom:1px solid #e5e7eb;\">Status</td>\n"
"                <td style=\"padding:8px; border-bottom:1px solid #e5e7eb;\" t-out=\"dict(object._fields['state']._description_selection(object.env)).get(object.state)\">Under analysis</td>\n"
"            </tr>\n"
"            <tr t-if=\"claimed\">\n"
"                <td style=\"padding:8px; color:#4b5563; border-bottom:1px solid #e5e7eb;\">Claimed</td>\n"
"                <td style=\"padding:8px; border-bottom:1px solid #e5e7eb;\" t-out=\"claimed\">$ 500,000.00</td>\n"
"            </tr>\n"
"            <tr t-if=\"pending and object.state == 'approved'\">\n"
"                <td style=\"padding:8px; color:#4b5563; border-bottom:1px solid #e5e7eb;\">Pending collection</td>\n"
"                <td style=\"padding:8px; font-weight:bold; border-bottom:1px solid #e5e7eb;\" t-out=\"pending\">$ 450,000.00</td>\n"
"            </tr>\n"
"        </table>\n"
"    </td></tr>\n"
"    <tr><td style=\"padding:16px 24px 8px 24px;\">\n"
"        <table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\">\n"
"            <tr><td bgcolor=\"#1f4e79\" style=\"border-radius:4px; background-color:#1f4e79;\">\n"
"                <a t-att-href=\"object._get_record_url()\" target=\"_blank\" style=\"display:inline-block; padding:12px 24px; font-family:Arial, Helvetica, sans-serif; font-size:15px; font-weight:bold; color:#ffffff; text-decoration:none; border-radius:4px;\">View claim</a>\n"
"            </td></tr>\n"
"        </table>\n"
"    </td></tr>\n"
"    <tr><td style=\"padding:16px 24px 24px 24px; font-size:12px; line-height:18px; color:#6b7280;\">\n"
"        You receive this email because you are the responsible of this claim at <t t-out=\"object.company_id.name or ''\">My Company</t>.\n"
"    </td></tr>\n"
"</table>\n"
"</td></tr>\n"
"</table>\n"
"</div>\n"
"            "
msgstr "<div style=\"margin:0; padding:0; background-color:#f3f4f6;\">\n<t t-set=\"claimed\" t-value=\"object._get_mail_amount('amount_claimed')\"/>\n<t t-set=\"pending\" t-value=\"object._get_mail_amount('amount_pending')\"/>\n<table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"background-color:#f3f4f6;\">\n<tr><td align=\"center\" style=\"padding:24px 12px;\">\n<table role=\"presentation\" width=\"600\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"width:100%; max-width:600px; background-color:#ffffff; border:1px solid #d1d5db; border-radius:6px; font-family:Arial, Helvetica, sans-serif; color:#1f2937;\">\n    <tr><td style=\"padding:20px 24px; border-bottom:3px solid #b54708;\">\n        <img t-att-src=\"'%s/logo.png?company=%s' % (object.get_base_url(), object.company_id.id)\" t-att-alt=\"object.company_id.name\" height=\"40\" style=\"height:40px; max-width:200px; border:0; display:block;\"/>\n    </td></tr>\n    <tr><td style=\"padding:24px 24px 8px 24px; font-size:15px; line-height:22px;\">\n        <p style=\"margin:0 0 16px 0;\">Hola <t t-out=\"ctx.get('insurance_recipient_name') or ''\">Marc Demo</t>,</p>\n        <p style=\"margin:0 0 16px 0; font-size:17px; line-height:24px; font-weight:bold; color:#b54708;\" t-out=\"object._get_stale_subject()\">El siniestro SIN/2026/0001 (póliza POL-001) lleva 30 días sin movimiento</p>\n        <p style=\"margin:0 0 16px 0;\">El estado de este siniestro no cambia hace un tiempo. Haga el seguimiento con la aseguradora o el productor.</p>\n    </td></tr>\n    <tr><td style=\"padding:0 24px 8px 24px;\">\n        <table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"font-size:14px; line-height:20px; border-collapse:collapse;\">\n            <tr>\n                <td style=\"padding:8px; width:38%; color:#4b5563; border-bottom:1px solid #e5e7eb;\">Siniestro</td>\n                <td style=\"padding:8px; font-weight:bold; border-bottom:1px solid #e5e7eb;\" t-out=\"object.display_name\">SIN/2026/0001</td>\n            </tr>\n            <tr>\n                <td style=\"padding:8px; color:#4b5563; border-bottom:1px solid #e5e7eb;\">Póliza</td>\n                <td style=\"padding:8px; border-bottom:1px solid #e5e7eb;\" t-out=\"object.policy_id.display_name\">SEG/2026/0001 - POL-001</td>\n            </tr>\n            <tr t-if=\"object.insurer_id\">\n                <td style=\"padding:8px; color:#4b5563; border-bottom:1px solid #e5e7eb;\">Aseguradora</td>\n                <td style=\"padding:8px; border-bottom:1px solid #e5e7eb;\" t-out=\"object.insurer_id.name\">Aseguradora</td>\n            </tr>\n            <tr>\n                <td style=\"padding:8px; color:#4b5563; border-bottom:1px solid #e5e7eb;\">Estado</td>\n                <td style=\"padding:8px; border-bottom:1px solid #e5e7eb;\" t-out=\"dict(object._fields['state']._description_selection(object.env)).get(object.state)\">En análisis</td>\n            </tr>\n            <tr t-if=\"claimed\">\n                <td style=\"padding:8px; color:#4b5563; border-bottom:1px solid #e5e7eb;\">Reclamado</td>\n                <td style=\"padding:8px; border-bottom:1px solid #e5e7eb;\" t-out=\"claimed\">$ 500,000.00</td>\n            </tr>\n            <tr t-if=\"pending and object.state == 'approved'\">\n                <td style=\"padding:8px; color:#4b5563; border-bottom:1px solid #e5e7eb;\">Pendiente de cobro</td>\n                <td style=\"padding:8px; font-weight:bold; border-bottom:1px solid #e5e7eb;\" t-out=\"pending\">$ 450,000.00</td>\n            </tr>\n        </table>\n    </td></tr>\n    <tr><td style=\"padding:16px 24px 8px 24px;\">\n        <table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\">\n            <tr><td bgcolor=\"#1f4e79\" style=\"border-radius:4px; background-color:#1f4e79;\">\n                <a t-att-href=\"object._get_record_url()\" target=\"_blank\" style=\"display:inline-block; padding:12px 24px; font-family:Arial, Helvetica, sans-serif; font-size:15px; font-weight:bold; color:#ffffff; text-decoration:none; border-radius:4px;\">Ver siniestro</a>\n            </td></tr>\n        </table>\n    </td></tr>\n    <tr><td style=\"padding:16px 24px 24px 24px; font-size:12px; line-height:18px; color:#6b7280;\">\n        Recibe este correo porque es el responsable de este siniestro en <t t-out=\"object.company_id.name or ''\">My Company</t>.\n    </td></tr>\n</table>\n</td></tr>\n</table>\n</div>\n            "

#. module: insurance_management
#: model:mail.template,body_html:insurance_management.mail_template_policy_expired
msgid ""
"<div style=\"margin:0; padding:0; background-color:#f3f4f6;\">\n"
"<t t-set=\"days_left\" t-value=\"ctx.get('insurance_days_left')\"/>\n"
"<t t-set=\"insured_objects\" t-value=\"object._get_mail_objects()\"/>\n"
"<table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"background-color:#f3f4f6;\">\n"
"<tr><td align=\"center\" style=\"padding:24px 12px;\">\n"
"<table role=\"presentation\" width=\"600\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"width:100%; max-width:600px; background-color:#ffffff; border:1px solid #d1d5db; border-radius:6px; font-family:Arial, Helvetica, sans-serif; color:#1f2937;\">\n"
"    <tr><td style=\"padding:20px 24px; border-bottom:3px solid #b42318;\">\n"
"        <img t-att-src=\"'%s/logo.png?company=%s' % (object.get_base_url(), object.company_id.id)\" t-att-alt=\"object.company_id.name\" height=\"40\" style=\"height:40px; max-width:200px; border:0; display:block;\"/>\n"
"    </td></tr>\n"
"    <tr><td style=\"padding:24px 24px 8px 24px; font-size:15px; line-height:22px;\">\n"
"        <p style=\"margin:0 0 16px 0;\">Hello <t t-out=\"ctx.get('insurance_recipient_name') or ''\">Marc Demo</t>,</p>\n"
"        <p style=\"margin:0 0 16px 0; font-size:17px; line-height:24px; font-weight:bold; color:#b42318;\" t-out=\"object._get_alert_subject('expired', days_left)\">Policy POL-001 (Motor) expired</p>\n"
"        <p style=\"margin:0 0 16px 0;\">The coverage of the following policy has ended and it was not renewed.</p>\n"
"    </td></tr>\n"
"    <tr><td style=\"padding:0 24px 8px 24px;\">\n"
"        <table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"font-size:14px; line-height:20px; border-collapse:collapse;\">\n"
"            <tr t-if=\"object.policy_number\">\n"
"                <td style=\"padding:8px; width:38%; color:#4b5563; border-bottom:1px solid #e5e7eb;\">Policy number</td>\n"
"                <td style=\"padding:8px; font-weight:bold; border-bottom:1px solid #e5e7eb;\" t-out=\"object.policy_number\">POL-001</td>\n"
"            </tr>\n"
"            <tr>\n"
"                <td style=\"padding:8px; width:38%; color:#4b5563; border-bottom:1px solid #e5e7eb;\">Reference</td>\n"
"                <td style=\"padding:8px; border-bottom:1px solid #e5e7eb;\" t-out=\"object.name\">SEG/2026/0001</td>\n"
"            </tr>\n"
"            <tr t-if=\"object.branch_id\">\n"
"                <td style=\"padding:8px; color:#4b5563; border-bottom:1px solid #e5e7eb;\">Branch</td>\n"
"                <td style=\"padding:8px; border-bottom:1px solid #e5e7eb;\" t-out=\"object.branch_id.name\">Motor</td>\n"
"            </tr>\n"
"            <tr t-if=\"object.insurer_id\">\n"
"                <td style=\"padding:8px; color:#4b5563; border-bottom:1px solid #e5e7eb;\">Insurer</td>\n"
"                <td style=\"padding:8px; border-bottom:1px solid #e5e7eb;\" t-out=\"object.insurer_id.name\">Insurer</td>\n"
"            </tr>\n"
"            <tr t-if=\"object.producer_id\">\n"
"                <td style=\"padding:8px; color:#4b5563; border-bottom:1px solid #e5e7eb;\">Producer</td>\n"
"                <td style=\"padding:8px; border-bottom:1px solid #e5e7eb;\" t-out=\"object.producer_id.name\">Producer</td>\n"
"            </tr>\n"
"            <tr t-if=\"object.date_from and object.date_to\">\n"
"                <td style=\"padding:8px; color:#4b5563; border-bottom:1px solid #e5e7eb;\">Validity</td>\n"
"                <td style=\"padding:8px; border-bottom:1px solid #e5e7eb;\" t-out=\"object._get_mail_validity()\">from 01/03/2026 until 12:00 on 28/02/2027</td>\n"
"            </tr>\n"
"            <tr>\n"
"                <td style=\"padding:8px; color:#4b5563; border-bottom:1px solid #e5e7eb;\">Renewal type</td>\n"
"                <td style=\"padding:8px; border-bottom:1px solid #e5e7eb;\" t-out=\"object._get_renewal_type_label()\">To be defined</td>\n"
"            </tr>\n"
"            <tr t-if=\"insured_objects\">\n"
"                <td style=\"padding:8px; color:#4b5563; border-bottom:1px solid #e5e7eb; vertical-align:top;\">Insured objects</td>\n"
"                <td style=\"padding:8px; border-bottom:1px solid #e5e7eb;\">\n"
"                    <t t-out=\"len(insured_objects)\">2</t>: <t t-foreach=\"insured_objects[:3]\" t-as=\"insured_object\"><t t-out=\"object._get_mail_object_label(insured_object)\">Truck (AB123CD)</t><t t-if=\"not insured_object_last\">, </t></t><t t-if=\"len(insured_objects) &gt; 3\"> (+<t t-out=\"len(insured_objects) - 3\">5</t>)</t>\n"
"                </td>\n"
"            </tr>\n"
"        </table>\n"
"    </td></tr>\n"
"    <tr><td style=\"padding:16px 24px 8px 24px; font-size:15px; line-height:22px;\">\n"
"        <p style=\"margin:0; padding:12px 14px; border-left:4px solid #b42318; background-color:#f9fafb;\">What to do: if the coverage must continue, renew it now (late renewal) and contact the producer. Otherwise no action is needed.</p>\n"
"    </td></tr>\n"
"    <tr><td style=\"padding:16px 24px 8px 24px;\">\n"
"        <table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\">\n"
"            <tr><td bgcolor=\"#1f4e79\" style=\"border-radius:4px; background-color:#1f4e79;\">\n"
"                <a t-att-href=\"object._get_record_url()\" target=\"_blank\" style=\"display:inline-block; padding:12px 24px; font-family:Arial, Helvetica, sans-serif; font-size:15px; font-weight:bold; color:#ffffff; text-decoration:none; border-radius:4px;\">View policy</a>\n"
"            </td></tr>\n"
"        </table>\n"
"    </td></tr>\n"
"    <tr><td style=\"padding:16px 24px 24px 24px; font-size:12px; line-height:18px; color:#6b7280;\">\n"
"        You receive this email because you are a user to notify for this policy at <t t-out=\"object.company_id.name or ''\">My Company</t>.\n"
"    </td></tr>\n"
"</table>\n"
"</td></tr>\n"
"</table>\n"
"</div>\n"
"            "
msgstr ""
"<div style=\"margin:0; padding:0; background-color:#f3f4f6;\">\n"
"<t t-set=\"days_left\" t-value=\"ctx.get('insurance_days_left')\"/>\n"
"<t t-set=\"insured_objects\" t-value=\"object._get_mail_objects()\"/>\n"
"<table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"background-color:#f3f4f6;\">\n"
"<tr><td align=\"center\" style=\"padding:24px 12px;\">\n"
"<table role=\"presentation\" width=\"600\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"width:100%; max-width:600px; background-color:#ffffff; border:1px solid #d1d5db; border-radius:6px; font-family:Arial, Helvetica, sans-serif; color:#1f2937;\">\n"
"    <tr><td style=\"padding:20px 24px; border-bottom:3px solid #b42318;\">\n"
"        <img t-att-src=\"'%s/logo.png?company=%s' % (object.get_base_url(), object.company_id.id)\" t-att-alt=\"object.company_id.name\" height=\"40\" style=\"height:40px; max-width:200px; border:0; display:block;\"/>\n"
"    </td></tr>\n"
"    <tr><td style=\"padding:24px 24px 8px 24px; font-size:15px; line-height:22px;\">\n"
"        <p style=\"margin:0 0 16px 0;\">Hola <t t-out=\"ctx.get('insurance_recipient_name') or ''\">Marc Demo</t>,</p>\n"
"        <p style=\"margin:0 0 16px 0; font-size:17px; line-height:24px; font-weight:bold; color:#b42318;\" t-out=\"object._get_alert_subject('expired', days_left)\">La póliza POL-001 (Automotor) venció</p>\n"
"        <p style=\"margin:0 0 16px 0;\">La cobertura de la siguiente póliza terminó y no fue renovada.</p>\n"
"    </td></tr>\n"
"    <tr><td style=\"padding:0 24px 8px 24px;\">\n"
"        <table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"font-size:14px; line-height:20px; border-collapse:collapse;\">\n"
"            <tr t-if=\"object.policy_number\">\n"
"                <td style=\"padding:8px; width:38%; color:#4b5563; border-bottom:1px solid #e5e7eb;\">Número de póliza</td>\n"
"                <td style=\"padding:8px; font-weight:bold; border-bottom:1px solid #e5e7eb;\" t-out=\"object.policy_number\">POL-001</td>\n"
"            </tr>\n"
"            <tr>\n"
"                <td style=\"padding:8px; width:38%; color:#4b5563; border-bottom:1px solid #e5e7eb;\">Referencia</td>\n"
"                <td style=\"padding:8px; border-bottom:1px solid #e5e7eb;\" t-out=\"object.name\">SEG/2026/0001</td>\n"
"            </tr>\n"
"            <tr t-if=\"object.branch_id\">\n"
"                <td style=\"padding:8px; color:#4b5563; border-bottom:1px solid #e5e7eb;\">Ramo</td>\n"
"                <td style=\"padding:8px; border-bottom:1px solid #e5e7eb;\" t-out=\"object.branch_id.name\">Automotor</td>\n"
"            </tr>\n"
"            <tr t-if=\"object.insurer_id\">\n"
"                <td style=\"padding:8px; color:#4b5563; border-bottom:1px solid #e5e7eb;\">Aseguradora</td>\n"
"                <td style=\"padding:8px; border-bottom:1px solid #e5e7eb;\" t-out=\"object.insurer_id.name\">Aseguradora</td>\n"
"            </tr>\n"
"            <tr t-if=\"object.producer_id\">\n"
"                <td style=\"padding:8px; color:#4b5563; border-bottom:1px solid #e5e7eb;\">Productor</td>\n"
"                <td style=\"padding:8px; border-bottom:1px solid #e5e7eb;\" t-out=\"object.producer_id.name\">Productor</td>\n"
"            </tr>\n"
"            <tr t-if=\"object.date_from and object.date_to\">\n"
"                <td style=\"padding:8px; color:#4b5563; border-bottom:1px solid #e5e7eb;\">Vigencia</td>\n"
"                <td style=\"padding:8px; border-bottom:1px solid #e5e7eb;\" t-out=\"object._get_mail_validity()\">desde el 01/03/2026 hasta las 12:00 del 28/02/2027</td>\n"
"            </tr>\n"
"            <tr>\n"
"                <td style=\"padding:8px; color:#4b5563; border-bottom:1px solid #e5e7eb;\">Tipo de renovación</td>\n"
