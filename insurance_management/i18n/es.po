e=\"padding:8px; color:#4b5563; border-bottom:1px solid #e5e7eb;\">Aseguradora</td>\n                <td style=\"padding:8px; border-bottom:1px solid #e5e7eb;\" t-out=\"object.insurer_id.name\">Aseguradora</td>\n            </tr>\n            <tr t-if=\"object.surety_beneficiary_id\">\n                <td style=\"padding:8px; color:#4b5563; border-bottom:1px solid #e5e7eb;\">Beneficiario</td>\n                <td style=\"padding:8px; border-bottom:1px solid #e5e7eb;\" t-out=\"object.surety_beneficiary_id.name\">Municipalidad</td>\n            </tr>\n            <tr t-if=\"object.surety_obligation\">\n                <td style=\"padding:8px; color:#4b5563; border-bottom:1px solid #e5e7eb;\">Obligación garantizada</td>\n                <td style=\"padding:8px; border-bottom:1px solid #e5e7eb;\" t-out=\"object.surety_obligation\">Licitación 12/2026</td>\n            </tr>\n            <tr t-if=\"object.surety_release_date\">\n                <td style=\"padding:8px; color:#4b5563; border-bottom:1px solid #e5e7eb;\">Fecha de liberación</td>\n                <td style=\"padding:8px; border-bottom:1px solid #e5e7eb;\" t-out=\"format_date(object.surety_release_date)\">30/06/2027</td>\n            </tr>\n        </table>\n    </td></tr>\n    <tr><td style=\"padding:20px 24px 24px 24px; font-size:15px; line-height:22px;\">\n        <p style=\"margin:0 0 16px 0;\">Muchas gracias.</p>\n        <p style=\"margin:0;\">Saludos cordiales,<br/>\n            <strong t-out=\"object.company_id.name or ''\">My Company</strong>\n            <t t-if=\"object.company_id.email\"><br/><t t-out=\"object.company_id.email\">info@example.com</t></t>\n            <t t-if=\"object.company_id.phone\"><br/><t t-out=\"object.company_id.phone\">+54 11 0000-0000</t></t>\n        </p>\n    </td></tr>\n</table>\n</td></tr>\n</table>\n</div>\n            "

