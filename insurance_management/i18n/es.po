"                <td style=\"padding:8px; border-bottom:1px solid #e5e7eb;\" t-out=\"object.branch_id.name\">Motor</td>\n"
"            </tr>\n"
"            <tr t-if=\"object.insurer_id\">\n"
"                <td style=\"padding:8px; color:#4b5563; border-bottom:1px solid #e5e7eb;\">Current insurer</td>\n"
"                <td style=\"padding:8px; border-bottom:1px solid #e5e7eb;\" t-out=\"object.insurer_id.name\">Insurer</td>\n"
"            </tr>\n"
"            <tr t-if=\"object.date_from and object.date_to\">\n"
"                <td style=\"padding:8px; color:#4b5563; border-bottom:1px solid #e5e7eb;\">Current validity</td>\n"
"                <td style=\"padding:8px; border-bottom:1px solid #e5e7eb;\" t-out=\"object._get_mail_validity()\">from 01/03/2026 until 12:00 on 28/02/2027</td>\n"
"            </tr>\n"
"        </table>\n"
"    </td></tr>\n"
"    <tr t-if=\"insured_objects\"><td style=\"padding:16px 24px 0 24px; font-size:14px; line-height:20px;\">\n"
"        <p style=\"margin:0 0 8px 0; font-weight:bold;\">Insured objects (<t t-out=\"len(insured_objects)\">2</t>)</p>\n"
"        <ul style=\"margin:0; padding:0 0 0 20px;\">\n"
"            <li t-foreach=\"insured_objects\" t-as=\"insured_object\" style=\"margin:0 0 4px 0;\">\n"
"                <t t-out=\"object._get_mail_object_label(insured_object)\">Truck (AB123CD)</t><t t-if=\"insured_object.coverage\"> - <t t-out=\"insured_object.coverage\">All risks</t></t>\n"
"            </li>\n"
"        </ul>\n"
"    </td></tr>\n"
"    <tr><td style=\"padding:20px 24px 24px 24px; font-size:15px; line-height:22px;\">\n"
"        <p style=\"margin:0 0 16px 0;\">Thank you in advance.</p>\n"
"        <p style=\"margin:0;\">Kind regards,<br/>\n"
"            <strong t-out=\"object.company_id.name or ''\">My Company</strong>\n"
"            <t t-if=\"object.company_id.email\"><br/><t t-out=\"object.company_id.email\">info@example.com</t></t>\n"
"            <t t-if=\"object.company_id.phone\"><br/><t t-out=\"object.company_id.phone\">+54 11 0000-0000</t></t>\n"
