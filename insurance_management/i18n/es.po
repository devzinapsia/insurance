#. module: insurance_management
#: model:mail.template,body_html:insurance_management.mail_template_policy_expiry_notice
msgid ""
"<div style=\"margin:0; padding:0; background-color:#f3f4f6;\">\n"
"<t t-set=\"days_left\" t-value=\"ctx.get('insurance_days_left')\"/>\n"
"<t t-set=\"insured_objects\" t-value=\"object._get_mail_objects()\"/>\n"
"<table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"background-color:#f3f4f6;\">\n"
"<tr><td align=\"center\" style=\"padding:24px 12px;\">\n"
"<table role=\"presentation\" width=\"600\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"width:100%; max-width:600px; background-color:#ffffff; border:1px solid #d1d5db; border-radius:6px; font-family:Arial, Helvetica, sans-serif; color:#1f2937;\">\n"
"    <tr><td style=\"padding:20px 24px; border-bottom:3px solid #b45309;\">\n"
"        <img t-att-src=\"'%s/logo.png?company=%s' % (object.get_base_url(), object.company_id.id)\" t-att-alt=\"object.company_id.name\" height=\"40\" style=\"height:40px; max-width:200px; border:0; display:block;\"/>\n"
"    </td></tr>\n"
"    <tr><td style=\"padding:24px 24px 8px 24px; font-size:15px; line-height:22px;\">\n"
"        <p style=\"margin:0 0 16px 0;\">Hello <t t-out=\"ctx.get('insurance_recipient_name') or ''\">Marc Demo</t>,</p>\n"
"        <p style=\"margin:0 0 16px 0; font-size:17px; line-height:24px; font-weight:bold; color:#b45309;\" t-out=\"object._get_alert_subject('expiry_notice', days_left)\">Policy POL-001 (Motor) expires in 15 days</p>\n"
"        <p style=\"margin:0 0 16px 0;\">The following policy is about to expire and needs a decision.</p>\n"
"    </td></tr>\n"
"    <tr><td style=\"padding:0 24px 8px 24px;\">\n"
"        <table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"font-size:14px; line-height:20px; border-collapse:collapse;\">\n"
"            <tr t-if=\"object.policy_number\">\n"
"                <td style=\"padding:8px; width:38%; color:#4b5563; border-bottom:1px solid #e5e7eb;\">Policy number</td>\n"
"                <td style=\"padding:8px; font-weight:bold; border-bottom:1px solid #e5e7eb;\" t-out=\"object.policy_number\">POL-001</td>\n"
"            </tr>\n"
"            <tr>\n"
"                <td style=\"padding:8px; width:38%; color:#4b5563; border-bottom:1px solid #e5e7eb;\">Reference</td>\n"
"                <td style=\"padding:8px; border-bottom:1px solid #e5e7eb;\" t-out=\"object.name\">SEG/2026/0001</td>\n"
"            </tr>\n"
"            <tr t-if=\"object.branch_id\">\n"
"                <td style=\"padding:8px; color:#4b5563; border-bottom:1px solid #e5e7eb;\">Branch</td>\n"
"                <td style=\"padding:8px; border-bottom:1px solid #e5e7eb;\" t-out=\"object.branch_id.name\">Motor</td>\n"
"            </tr>\n"
"            <tr t-if=\"object.insurer_id\">\n"
"                <td style=\"padding:8px; color:#4b5563; border-bottom:1px solid #e5e7eb;\">Insurer</td>\n"
"                <td style=\"padding:8px; border-bottom:1px solid #e5e7eb;\" t-out=\"object.insurer_id.name\">Insurer</td>\n"
"            </tr>\n"
"            <tr t-if=\"object.producer_id\">\n"
"                <td style=\"padding:8px; color:#4b5563; border-bottom:1px solid #e5e7eb;\">Producer</td>\n"
"                <td style=\"padding:8px; border-bottom:1px solid #e5e7eb;\" t-out=\"object.producer_id.name\">Producer</td>\n"
"            </tr>\n"
"            <tr t-if=\"object.date_from and object.date_to\">\n"
"                <td style=\"padding:8px; color:#4b5563; border-bottom:1px solid #e5e7eb;\">Validity</td>\n"
"                <td style=\"padding:8px; border-bottom:1px solid #e5e7eb;\" t-out=\"object._get_mail_validity()\">from 01/03/2026 until 12:00 on 28/02/2027</td>\n"
"            </tr>\n"
"            <tr t-if=\"days_left is not None and days_left &gt;= 0\">\n"
"                <td style=\"padding:8px; color:#4b5563; border-bottom:1px solid #e5e7eb;\">Days left</td>\n"
"                <td style=\"padding:8px; font-weight:bold; border-bottom:1px solid #e5e7eb;\" t-out=\"days_left\">15</td>\n"
"            </tr>\n"
"            <tr>\n"
"                <td style=\"padding:8px; color:#4b5563; border-bottom:1px solid #e5e7eb;\">Renewal type</td>\n"
"                <td style=\"padding:8px; border-bottom:1px solid #e5e7eb;\" t-out=\"object._get_renewal_type_label()\">To be defined</td>\n"
"            </tr>\n"
"            <tr t-if=\"insured_objects\">\n"
"                <td style=\"padding:8px; color:#4b5563; border-bottom:1px solid #e5e7eb; vertical-align:top;\">Insured objects</td>\n"
"                <td style=\"padding:8px; border-bottom:1px solid #e5e7eb;\">\n"
"                    <t t-out=\"len(insured_objects)\">2</t>: <t t-foreach=\"insured_objects[:3]\" t-as=\"insured_object\"><t t-out=\"object._get_mail_object_label(insured_object)\">Truck (AB123CD)</t><t t-if=\"not insured_object_last\">, </t></t><t t-if=\"len(insured_objects) &gt; 3\"> (+<t t-out=\"len(insured_objects) - 3\">5</t>)</t>\n"
"                </td>\n"
"            </tr>\n"
"        </table>\n"
"    </td></tr>\n"
"    <tr><td style=\"padding:16px 24px 8px 24px; font-size:15px; line-height:22px;\">\n"
"        <p style=\"margin:0; padding:12px 14px; border-left:4px solid #b45309; background-color:#f9fafb;\">What to do: decide whether to renew it. From the policy you can renew it, mark it not to renew (the producer is notified) or request a renewal proposal from the producer.</p>\n"
"    </td></tr>\n"
"    <tr><td style=\"padding:16px 24px 8px 24px;\">\n"
"        <table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\">\n"
"            <tr><td bgcolor=\"#1f4e79\" style=\"border-radius:4px; background-color:#1f4e79;\">\n"
"                <a t-att-href=\"object._get_record_url()\" target=\"_blank\" style=\"display:inline-block; padding:12px 24px; font-family:Arial, Helvetica, sans-serif; font-size:15px; font-weight:bold; color:#ffffff; text-decoration:none; border-radius:4px;\">View policy</a>\n"
"            </td></tr>\n"
"        </table>\n"
"    </td></tr>\n"
"    <tr><td style=\"padding:16px 24px 24px 24px; font-size:12px; line-height:18px; color:#6b7280;\">\n"
"        You receive this email because you are a user to notify for this policy at <t t-out=\"object.company_id.name or ''\">My Company</t>.\n"
"    </td></tr>\n"
"</table>\n"
"</td></tr>\n"
"</table>\n"
"</div>\n"
"            "
