"    </td></tr>\n"
"    <tr><td style=\"padding:0 24px 8px 24px;\">\n"
"        <table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"font-size:14px; line-height:20px; border-collapse:collapse;\">\n"
"            <tr t-if=\"object.policy_number\">\n"
"                <td style=\"padding:8px; width:38%; color:#4b5563; border-bottom:1px solid #e5e7eb;\">Número de póliza</td>\n"
"                <td style=\"padding:8px; font-weight:bold; border-bottom:1px solid #e5e7eb;\" t-out=\"object.policy_number\">POL-001</td>\n"
"            </tr>\n"
"            <tr t-if=\"object.branch_id\">\n"
"                <td style=\"padding:8px; color:#4b5563; border-bottom:1px solid #e5e7eb;\">Ramo</td>\n"
"                <td style=\"padding:8px; border-bottom:1px solid #e5e7eb;\" t-out=\"object.branch_id.name\">Automotor</td>\n"
"            </tr>\n"
"            <tr t-if=\"object.insurer_id\">\n"
