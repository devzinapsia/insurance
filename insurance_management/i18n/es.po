"            </tr>\n"
"            <tr t-if=\"installment\">\n"
"                <td style=\"padding:8px; color:#4b5563; border-bottom:1px solid #e5e7eb;\">Cuota</td>\n"
"                <td style=\"padding:8px; font-weight:bold; border-bottom:1px solid #e5e7eb;\" t-out=\"installment.name\">3/12</td>\n"
"            </tr>\n"
"            <tr t-if=\"installment\">\n"
"                <td style=\"padding:8px; color:#4b5563; border-bottom:1px solid #e5e7eb;\">Vencimiento</td>\n"
"                <td style=\"padding:8px; border-bottom:1px solid #e5e7eb;\" t-out=\"format_date(installment.due_date)\">01/03/2026</td>\n"
"            </tr>\n"
"            <tr t-if=\"amount_text\">\n"
"                <td style=\"padding:8px; color:#4b5563; border-bottom:1px solid #e5e7eb;\">Importe</td>\n"
"                <td style=\"padding:8px; font-weight:bold; border-bottom:1px solid #e5e7eb;\" t-out=\"amount_text\">$ 100,000.00</td>\n"
"            </tr>\n"
"            <tr t-if=\"installment and installment.payment_mode_id\">\n"
"                <td style=\"padding:8px; color:#4b5563; border-bottom:1px solid #e5e7eb;\">Medio de pago</td>\n"
"                <td style=\"padding:8px; border-bottom:1px solid #e5e7eb;\" t-out=\"installment.payment_mode_id.name\">Débito bancario</td>\n"
"            </tr>\n"
"        </table>\n"
"    </td></tr>\n"
"    <tr><td style=\"padding:16px 24px 8px 24px; font-size:15px; line-height:22px;\">\n"
"        <p style=\"margin:0; padding:12px 14px; border-left:4px solid #b42318; background-color:#f9fafb;\">Qué hacer: revise por qué no se hizo el pago (débito rechazado, pago no generado o no publicado) y pague la cuota, o consulte a la aseguradora por la cobertura.</p>\n"
"    </td></tr>\n"
"    <tr><td style=\"padding:16px 24px 8px 24px;\">\n"
"        <table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\">\n"
"            <tr><td bgcolor=\"#1f4e79\" style=\"border-radius:4px; background-color:#1f4e79;\">\n"
"                <a t-att-href=\"object._get_record_url()\" target=\"_blank\" style=\"display:inline-block; padding:12px 24px; font-family:Arial, Helvetica, sans-serif; font-size:15px; font-weight:bold; color:#ffffff; text-decoration:none; border-radius:4px;\">Ver póliza</a>\n"
"            </td></tr>\n"
"        </table>\n"
"    </td></tr>\n"
"    <tr><td style=\"padding:16px 24px 24px 24px; font-size:12px; line-height:18px; color:#6b7280;\">\n"
