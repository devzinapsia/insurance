"<t t-set=\"insured_objects\" t-value=\"object._get_mail_objects()\"/>\n"
"<table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"background-color:#f3f4f6;\">\n"
