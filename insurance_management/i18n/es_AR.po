"    <tr><td style=\"padding:24px 24px 8px 24px; font-size:15px; line-height:22px;\">\n"
"        <p style=\"margin:0 0 16px 0;\">Hola <t t-out=\"ctx.get('insurance_recipient_name') or ''\">Marc Demo</t>,</p>\n"
"        <p style=\"margin:0 0 16px 0; font-size:17px; line-height:24px; font-weight:bold; color:#b45309;\" t-out=\"object._get_alert_subject('expiry_notice', days_left)\">La póliza POL-001 (Automotor) vence en 15 días</p>\n"
"        <p style=\"margin:0 0 16px 0;\">La siguiente póliza está por vencer y requiere una decisión.</p>\n"
"    </td></tr>\n"
"    <tr><td style=\"padding:0 24px 8px 24px;\">\n"
"        <table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"font-size:14px; line-height:20px; border-collapse:collapse;\">\n"
"            <tr t-if=\"object.policy_number\">\n"
"                <td style=\"padding:8px; width:38%; color:#4b5563; border-bottom:1px solid #e5e7eb;\">Número de póliza</td>\n"
"                <td style=\"padding:8px; font-weight:bold; border-bottom:1px solid #e5e7eb;\" t-out=\"object.policy_number\">POL-001</td>\n"
"            </tr>\n"
"            <tr>\n"
"                <td style=\"padding:8px; width:38%; color:#4b5563; border-bottom:1px solid #e5e7eb;\">Referencia</td>\n"
"                <td style=\"padding:8px; border-bottom:1px solid #e5e7eb;\" t-out=\"object.name\">SEG/2026/0001</td>\n"
"            </tr>\n"
"            <tr t-if=\"object.branch_id\">\n"
"                <td style=\"padding:8px; color:#4b5563; border-bottom:1px solid #e5e7eb;\">Ramo</td>\n"
"                <td style=\"padding:8px; border-bottom:1px solid #e5e7eb;\" t-out=\"object.branch_id.name\">Automotor</td>\n"
"            </tr>\n"
"            <tr t-if=\"object.insurer_id\">\n"
"                <td style=\"padding:8px; color:#4b5563; border-bottom:1px solid #e5e7eb;\">Aseguradora</td>\n"
"                <td style=\"padding:8px; border-bottom:1px solid #e5e7eb;\" t-out=\"object.insurer_id.name\">Aseguradora</td>\n"
"            </tr>\n"
"            <tr t-if=\"object.producer_id\">\n"
"                <td style=\"padding:8px; color:#4b5563; border-bottom:1px solid #e5e7eb;\">Productor</td>\n"
"                <td style=\"padding:8px; border-bottom:1px solid #e5e7eb;\" t-out=\"object.producer_id.name\">Productor</td>\n"
"            </tr>\n"
"            <tr t-if=\"object.date_from and object.date_to\">\n"
"                <td style=\"padding:8px; color:#4b5563; border-bottom:1px solid #e5e7eb;\">Vigencia</td>\n"
"                <td style=\"padding:8px; border-bottom:1px solid #e5e7eb;\" t-out=\"object._get_mail_validity()\">desde el 01/03/2026 hasta las 12:00 del 28/02/2027</td>\n"
"            </tr>\n"
"            <tr t-if=\"days_left is not None and days_left &gt;= 0\">\n"
"                <td style=\"padding:8px; color:#4b5563; border-bottom:1px solid #e5e7eb;\">Días restantes</td>\n"
"                <td style=\"padding:8px; font-weight:bold; border-bottom:1px solid #e5e7eb;\" t-out=\"days_left\">15</td>\n"
"            </tr>\n"
"            <tr>\n"
"                <td style=\"padding:8px; color:#4b5563; border-bottom:1px solid #e5e7eb;\">Tipo de renovación</td>\n"
"                <td style=\"padding:8px; border-bottom:1px solid #e5e7eb;\" t-out=\"object._get_renewal_type_label()\">A definir</td>\n"
"            </tr>\n"
"            <tr t-if=\"insured_objects\">\n"
"                <td style=\"padding:8px; color:#4b5563; border-bottom:1px solid #e5e7eb; vertical-align:top;\">Objetos asegurados</td>\n"
"                <td style=\"padding:8px; border-bottom:1px solid #e5e7eb;\">\n"
"                    <t t-out=\"len(insured_objects)\">2</t>: <t t-foreach=\"insured_objects[:3]\" t-as=\"insured_object\"><t t-out=\"object._get_mail_object_label(insured_object)\">Camión (AB123CD)</t><t t-if=\"not insured_object_last\">, </t></t><t t-if=\"len(insured_objects) &gt; 3\"> (+<t t-out=\"len(insured_objects) - 3\">5</t>)</t>\n"
"                </td>\n"
"            </tr>\n"
"        </table>\n"
"    </td></tr>\n"
"    <tr><td style=\"padding:16px 24px 8px 24px; font-size:15px; line-height:22px;\">\n"
"        <p style=\"margin:0; padding:12px 14px; border-left:4px solid #b45309; background-color:#f9fafb;\">Qué hacer: decida si la renueva. Desde la póliza puede renovarla, marcarla para no renovar (se avisa al productor) o pedirle al productor una propuesta de renovación.</p>\n"
"    </td></tr>\n"
"    <tr><td style=\"padding:16px 24px 8px 24px;\">\n"
"        <table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\">\n"
"            <tr><td bgcolor=\"#1f4e79\" style=\"border-radius:4px; background-color:#1f4e79;\">\n"
"                <a t-att-href=\"object._get_record_url()\" target=\"_blank\" style=\"display:inline-block; padding:12px 24px; font-family:Arial, Helvetica, sans-serif; font-size:15px; font-weight:bold; color:#ffffff; text-decoration:none; border-radius:4px;\">Ver póliza</a>\n"
"            </td></tr>\n"
"        </table>\n"
"    </td></tr>\n"
"    <tr><td style=\"padding:16px 24px 24px 24px; font-size:12px; line-height:18px; color:#6b7280;\">\n"
"        Recibe este correo porque es un usuario a notificar de esta póliza en <t t-out=\"object.company_id.name or ''\">Mi compañía</t>.\n"
"    </td></tr>\n"
"</table>\n"
"</td></tr>\n"
"</table>\n"
"</div>\n"
"            "

