"                <td style=\"padding:8px; border-bottom:1px solid #e5e7eb;\" t-out=\"object.insurer_id.name\">Insurer</td>\n"
"            </tr>\n"
"            <tr t-if=\"installment\">\n"
"                <td style=\"padding:8px; color:#4b5563; border-bottom:1px solid #e5e7eb;\">Installment</td>\n"
"                <td style=\"padding:8px; font-weight:bold; border-bottom:1px solid #e5e7eb;\" t-out=\"installment.name\">3/12</td>\n"
"            </tr>\n"
"            <tr t-if=\"installment\">\n"
"                <td style=\"padding:8px; color:#4b5563; border-bottom:1px solid #e5e7eb;\">Due date</td>\n"
"                <td style=\"padding:8px; border-bottom:1px solid #e5e7eb;\" t-out=\"format_date(installment.due_date)\">01/03/2026</td>\n"
"            </tr>\n"
"            <tr t-if=\"amount_text\">\n"
"                <td style=\"padding:8px; color:#4b5563; border-bottom:1px solid #e5e7eb;\">Amount</td>\n"
"                <td style=\"padding:8px; font-weight:bold; border-bottom:1px solid #e5e7eb;\" t-out=\"amount_text\">$ 100,000.00</td>\n"
"            </tr>\n"
"            <tr t-if=\"installment and installment.payment_mode_id\">\n"
"                <td style=\"padding:8px; color:#4b5563; border-bottom:1px solid #e5e7eb;\">Payment mode</td>\n"
"                <td style=\"padding:8px; border-bottom:1px solid #e5e7eb;\" t-out=\"installment.payment_mode_id.name\">Bank debit</td>\n"
