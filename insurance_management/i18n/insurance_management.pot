"        <p style=\"margin:0 0 16px 0;\">On behalf of <t t-out=\"object.company_id.name or ''\">My Company</t>, we instruct you not to renew this policy when its validity ends. Please inform the insurer, so that it is neither renewed nor invoiced again.</p>\n"
"    </td></tr>\n"
"    <tr><td style=\"padding:0 24px 8px 24px;\">\n"
"        <table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"font-size:14px; line-height:20px; border-collapse:collapse;\">\n"
"            <tr t-if=\"object.policy_number\">\n"
"                <td style=\"padding:8px; width:38%; color:#4b5563; border-bottom:1px solid #e5e7eb;\">Policy number</td>\n"
"                <td style=\"padding:8px; font-weight:bold; border-bottom:1px solid #e5e7eb;\" t-out=\"object.policy_number\">POL-001</td>\n"
"            </tr>\n"
"            <tr t-if=\"object.branch_id\">\n"
"                <td style=\"padding:8px; color:#4b5563; border-bottom:1px solid #e5e7eb;\">Branch</td>\n"
"                <td style=\"padding:8px; border-bottom:1px solid #e5e7eb;\" t-out=\"object.branch_id.name\">Motor</td>\n"
"            </tr>\n"
"            <tr t-if=\"object.insurer_id\">\n"
"                <td style=\"padding:8px; color:#4b5563; border-bottom:1px solid #e5e7eb;\">Insurer</td>\n"
"                <td style=\"padding:8px; border-bottom:1px solid #e5e7eb;\" t-out=\"object.insurer_id.name\">Insurer</td>\n"
"            </tr>\n"
