        <field name="name">Validity extension</field>
        <field name="kind">extension</field>
        <field name="sequence">70</field>
    </record>
    <record id="insurance_endorsement_type_cancellation" model="insurance.endorsement.type">
        <field name="name">Cancellation</field>
        <field name="kind">cancellation</field>
        <field name="sequence">80</field>
    </record>
</odoo>
